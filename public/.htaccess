# MetalRenova — configuración para Hostinger (LiteSpeed/Apache)

# --- HTTPS + dominio sin www (canonical) ---------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://chatarreriametalrenova.es%{REQUEST_URI} [L,R=301,NE]

# --- Página de error 404 --------------------------------------------------
ErrorDocument 404 /404.html

# --- Compresión ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml
</IfModule>

# --- Caché del navegador ----------------------------------------------------
<IfModule mod_headers.c>
  # Los archivos de _astro/ llevan hash en el nombre: si cambian, cambia la URL.
  # Se pueden cachear "para siempre" sin miedo a servir una versión vieja.
  <FilesMatch "\.(css|js|woff2?|svg|webp|avif|png|jpe?g|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- Cabeceras de seguridad básicas ---------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Sin listado de directorios --------------------------------------------
Options -Indexes
