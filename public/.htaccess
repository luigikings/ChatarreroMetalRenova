# MetalRenova — configuración para Hostinger (LiteSpeed/Apache)

# --- HTTPS + dominio sin www (canonical) ---------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://chatarreriametalrenova.es%{REQUEST_URI} [L,R=301,NE]

# --- /favicon.ico -> icono PNG grande (no hay .ico real) -------------------
RewriteRule ^favicon\.ico$ /icon-512.png [L,R=301]

# --- Barra final en las páginas (directorios existentes) -----------------
# Explícito en vez de depender de DirectorySlash de mod_dir.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

# --- Marca los archivos con huella de versión (Astro los genera en /_astro/)
RewriteRule ^_astro/ - [E=CON_HUELLA:1]

# --- Página de error 404 --------------------------------------------------
ErrorDocument 404 /404.html

# --- Compresión ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml
</IfModule>

# --- Caché del navegador ----------------------------------------------------
<IfModule mod_headers.c>
  # Los archivos de _astro/ llevan hash en el nombre (CON_HUELLA): si cambian,
  # cambia la URL, así que se cachean un año sin miedo a servir una versión vieja.
  # El resto de estáticos (imágenes, iconos y fuentes de public/) no llevan hash:
  # 30 días y sin immutable, para que un cambio llegue a los visitantes.
  <FilesMatch "\.(css|js|woff2?|svg|webp|avif|png|jpe?g|gif|ico)$">
    Header set Cache-Control "public, max-age=2592000" env=!CON_HUELLA
    Header set Cache-Control "public, max-age=31536000, immutable" env=CON_HUELLA
  </FilesMatch>
  # Páginas, sitemap y robots.txt: siempre se revalidan.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # --- HSTS: solo HTTPS durante un año (sin includeSubDomains ni preload) ---
  Header always set Strict-Transport-Security "max-age=31536000"

  # --- Cabeceras de seguridad básicas ---------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Sin listado de directorios --------------------------------------------
Options -Indexes
