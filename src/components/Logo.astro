---
// Marca de MetalRenova: icono "M" real del cliente + wordmark
// (METAL sólido + RENOVA en contorno, igual que el logo oficial).
import { Image } from 'astro:assets';
import logoMark from '../assets/logo/logo-mark.png';
---
<a href="/" class="logo" aria-label="MetalRenova — ir al inicio">
  <Image src={logoMark} alt="" width={60} height={60} class="logo-mark" />
  <span class="logo-word"><span class="logo-word__solid">Metal</span><span class="logo-word__outline">Renova</span></span>
</a>

<style>
  .logo-mark { width: 30px; height: 30px; flex-shrink: 0; }
</style>
