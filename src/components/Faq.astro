---
// Acordeón de preguntas frecuentes con <details>, sin JavaScript.
interface QA { question: string; answer: string }
interface Props { items: QA[]; title?: string }
const { items, title = 'Preguntas frecuentes' } = Astro.props;
---
<div class="faq-wrap">
  <h2>{title}</h2>
  <div class="faq">
    {items.map((qa) => (
      <details>
        <summary>{qa.question}</summary>
        <p>{qa.answer}</p>
      </details>
    ))}
  </div>
</div>
