---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, whatsappLink } from '../config/site';

const title = 'Compra de metales y chatarra en Madrid | MetalRenova';
const description =
  'Compramos cobre, aluminio, bronce, acero, latón, plomo, níquel, zinc, virutas y baterías en Getafe y Madrid, con recogida gratuita y pago inmediato.';

const materials = [
  { name: 'Cobre', text: 'Cableado, tuberías y restos eléctricos. Pagamos según la cotización del día y retiramos todo a domicilio sin coste.' },
  { name: 'Aluminio', text: 'Perfiles, ventanas, chapas y piezas industriales, con recogida ágil y pago inmediato.' },
  { name: 'Bronce', text: 'Grifería, piezas industriales y elementos ornamentales, con una valoración justa y pago al momento.' },
  { name: 'Hierro y acero', text: 'Estructuras, vigas y chatarra pesada. Nos encargamos del transporte y la carga.' },
  { name: 'Latón', text: 'Válvulas, piezas mecánicas y restos de producción, con un servicio rápido y sin complicaciones.' },
  { name: 'Plomo', text: 'Tuberías antiguas y materiales pesados, con una gestión segura.' },
  { name: 'Níquel', text: 'Aleaciones especiales y materiales técnicos de alto valor, con recogida directa en tu ubicación.' },
  { name: 'Zinc', text: 'Chapas, cubiertas y restos de obra galvanizados, liberando tu espacio de forma inmediata.' },
  { name: 'Virutas', text: 'Restos de mecanizado y residuos industriales, con recogida rápida para mantener tu zona de trabajo operativa.' },
  { name: 'Baterías usadas', text: 'Recogida de baterías de vehículos y maquinaria, sin coste para ti.' },
];
---

<Layout title={title} description={description} breadcrumbs={[{ name: 'Gestión de metales', path: '/gestion-de-metales/' }]}>
  <Breadcrumbs items={[{ name: 'Gestión de metales', path: '/gestion-de-metales/' }]} />

  <section class="hero" style="padding-top:1rem">
    <div class="container">
      <span class="eyebrow">Materiales</span>
      <h1>Compramos metales y chatarra en Getafe y Madrid</h1>
      <p class="lead">
        Compramos todo tipo de metales, con recogida a domicilio gratuita y pago inmediato
        según la cotización del día. Envíanos fotos por WhatsApp y te decimos el precio.
      </p>
      <div class="btn-row">
        <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, quiero saber el precio de mi material.')} data-track="whatsapp">
          <Icon name="whatsapp" style="width:20px;height:20px" />
          Solicitar precio por WhatsApp
        </a>
        <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
          <Icon name="phone" style="width:20px;height:20px" />
          Llamar
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Qué compramos</span>
        <h2>Te compramos esto y te pagamos bien</h2>
      </div>
      <div class="grid grid--3">
        {materials.map((m) => (
          <div class="material-card">
            <span class="material-card__name">{m.name}</span>
            <p class="mt-0">{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="cta-final">
        <h2>¿Listo para recuperar tu espacio?</h2>
        <p style="margin-inline:auto">Mándanos fotos del material y te decimos el precio al instante.</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, quiero saber el precio de mi material.')} data-track="whatsapp">
            <Icon name="whatsapp" style="width:20px;height:20px" />
            Solicitar recogida gratuita
          </a>
          <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
            <Icon name="phone" style="width:20px;height:20px" />
            Llamar
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
