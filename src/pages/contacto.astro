---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, whatsappLink } from '../config/site';

const title = 'Contacto | MetalRenova, chatarrero en Getafe';
const description =
  'Llama o escribe por WhatsApp a MetalRenova para vender tu chatarra en Getafe y el sur de Madrid. Recogida a domicilio, abierto 24 horas todos los días.';
---

<Layout title={title} description={description} breadcrumbs={[{ name: 'Contacto', path: '/contacto/' }]}>
  <Breadcrumbs items={[{ name: 'Contacto', path: '/contacto/' }]} />

  <section class="hero" style="padding-top:1rem">
    <div class="container">
      <span class="eyebrow">Contacto</span>
      <h1>Contacta con MetalRenova en Getafe</h1>
      <p class="lead">
        La forma más rápida de recibir un precio es por WhatsApp, mandándonos fotos del
        material. También puedes llamarnos directamente.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        <div class="card">
          <Icon name="whatsapp" class="icon" />
          <h2>WhatsApp</h2>
          <p>Respuesta rápida, con fotos y precio orientativo al momento.</p>
          <a class="btn btn--whatsapp btn--block" href={whatsappLink('Hola MetalRenova, quiero poneros en contacto.')} data-track="whatsapp">
            Escribir por WhatsApp
          </a>
        </div>
        <div class="card">
          <Icon name="phone" class="icon" />
          <h2>Teléfono</h2>
          <p>Puedes llamarnos a cualquiera de estos dos números.</p>
          <a class="btn btn--call btn--block" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">{site.phonePrimary}</a>
          <a class="btn btn--call btn--block" style="margin-top:0.6rem" href={`tel:${site.phoneSecondaryTel}`} data-track="llamar">{site.phoneSecondary}</a>
        </div>
        <div class="card">
          <Icon name="mappin" class="icon" />
          <h2>Dónde estamos</h2>
          <p>{site.address.street}, {site.address.postalCode} {site.address.city}</p>
          <a class="btn btn--call btn--block" href={site.address.mapsUrl} target="_blank" rel="noopener noreferrer">
            Cómo llegar
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="grid grid--2">
        <div>
          <span class="eyebrow">Horario</span>
          <h2>{site.hours.label}</h2>
          <p>Intentamos recoger el mismo día según disponibilidad y la zona.</p>
        </div>
        <div>
          <span class="eyebrow">Zonas</span>
          <h2>Dónde trabajamos</h2>
          <ul class="zone-list">
            {site.zones.map((zone) => (
              <li><a href={zone.page}>{zone.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
