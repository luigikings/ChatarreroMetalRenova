---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MaterialLinks from '../components/MaterialLinks.astro';
import Faq from '../components/Faq.astro';
import OtherZones from '../components/OtherZones.astro';
import { site, whatsappLink } from '../config/site';

const title = 'Chatarrería y chatarrero en Fuenlabrada | MetalRenova';
const description =
  'Compramos chatarra y metales en Fuenlabrada, con recogida a domicilio y pago inmediato. Cobre, aluminio, hierro y más, sin que te muevas de casa.';

const faqItems = [
  {
    question: '¿Vais también a naves y polígonos industriales de Fuenlabrada?',
    answer: 'Sí, trabajamos tanto en domicilios particulares como en naves, talleres y polígonos industriales.',
  },
  {
    question: '¿Hace falta pedir cita con mucha antelación?',
    answer: 'No necesariamente. Escríbenos por WhatsApp y te decimos si podemos ir el mismo día según la carga de trabajo de esa jornada.',
  },
];
---

<Layout title={title} description={description} breadcrumbs={[{ name: 'Chatarrero en Fuenlabrada', path: '/chatarrero-fuenlabrada/' }]}>
  <Breadcrumbs items={[{ name: 'Chatarrero en Fuenlabrada', path: '/chatarrero-fuenlabrada/' }]} />

  <section class="hero hero--cyan" style="padding-top:1rem">
    <div class="container">
      <span class="eyebrow">Fuenlabrada</span>
      <h1>Chatarrería y chatarrero en Fuenlabrada</h1>
      <p class="lead">
        Fuenlabrada es una de las zonas donde más trabajamos, cerca de nuestra base en Getafe.
        Si tienes chatarra o metales acumulados, nos mandas unas fotos por WhatsApp y
        coordinamos la recogida en tu domicilio, taller o nave.
      </p>
      <div class="btn-row">
        <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, estoy en Fuenlabrada y tengo chatarra para vender.')} data-track="whatsapp">
          <Icon name="whatsapp" style="width:20px;height:20px" />
          Pide recogida en Fuenlabrada
        </a>
        <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
          <Icon name="phone" style="width:20px;height:20px" />
          Llamar
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Servicio en Fuenlabrada</span>
        <h2>Recogida de metales con pago al momento</h2>
        <p>
          En Fuenlabrada compramos los mismos materiales que en el resto de zonas donde
          trabajamos: cobre, aluminio, hierro, latón, baterías y más. Puedes ver el listado
          completo en <a href="/gestion-de-metales/">gestión de metales</a> o consultar
          cómo calculamos el precio en <a href="/precios-chatarra/">precios de la
          chatarra</a>.
        </p>
        <p>
          También trabajamos en <a href="/vaciado-de-pisos-y-naves/">vaciados de pisos,
          locales y naves</a> en Fuenlabrada, si necesitas liberar un espacio completo en
          lugar de vender solo el metal.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <Faq items={faqItems} title="Preguntas sobre el servicio en Fuenlabrada" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <MaterialLinks heading="Materiales que recogemos en Fuenlabrada" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <OtherZones current="fuenlabrada" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-final">
        <h2>¿Tienes chatarra en Fuenlabrada?</h2>
        <p style="margin-inline:auto">Escríbenos por WhatsApp con fotos y te decimos el precio en minutos.</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, estoy en Fuenlabrada y tengo chatarra para vender.')} data-track="whatsapp">
            <Icon name="whatsapp" style="width:20px;height:20px" />
            Pide recogida en Fuenlabrada
          </a>
          <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
            <Icon name="phone" style="width:20px;height:20px" />
            Llamar
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
