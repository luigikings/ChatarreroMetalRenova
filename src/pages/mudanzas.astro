---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { site, whatsappLink } from '../config/site';

const title = 'Mudanzas y portes en Madrid | MetalRenova';
const description =
  'Mudanzas de casas y oficinas y portes de muebles sueltos en todo Madrid: carga, transporte y descarga. Pide presupuesto gratis por WhatsApp.';

const whatsappMsg = 'Hola MetalRenova, quiero presupuesto para una mudanza.';

const steps = [
  {
    icon: 'camera' as const,
    title: 'Cuéntanos qué hay que mover',
    text: 'Por WhatsApp, con fotos o una lista de muebles y cajas, la dirección de origen y la de destino, y si hay ascensor en cada una.',
  },
  {
    icon: 'coin' as const,
    title: 'Te damos presupuesto',
    text: 'Con esa información te pasamos un presupuesto gratis y sin compromiso, y acordamos el día y la hora que mejor te vengan.',
  },
  {
    icon: 'truck' as const,
    title: 'Hacemos el traslado',
    text: 'El día acordado cargamos, transportamos y descargamos tus cosas en el nuevo domicilio u oficina.',
  },
];

const faqItems = [
  {
    question: '¿El presupuesto de la mudanza tiene algún coste?',
    answer: 'No. El presupuesto es gratis y sin compromiso. Nos mandas la información por WhatsApp y te respondemos con el precio.',
  },
  {
    question: '¿Qué información necesitáis para darme precio?',
    answer: 'Qué hay que mover (con fotos o una lista), la dirección de origen y la de destino, en qué planta está cada una y si hay ascensor, y qué día te vendría bien.',
  },
  {
    question: '¿Hacéis portes de un solo mueble o electrodoméstico?',
    answer: 'Sí. Además de mudanzas completas hacemos portes: llevar un sofá, un armario, una lavadora o unas pocas cosas de un sitio a otro. Cuéntanos qué es y te damos precio.',
  },
  {
    question: '¿Os podéis llevar lo que no quiero en la casa nueva?',
    answer: 'Sí. Podemos retirar los muebles, trastos o electrodomésticos que no te lleves, y si entre ellos hay chatarra o metales, te los compramos como en cualquier recogida.',
  },
];
---

<Layout title={title} description={description} breadcrumbs={[{ name: 'Mudanzas', path: '/mudanzas/' }]}>
  <Breadcrumbs items={[{ name: 'Mudanzas', path: '/mudanzas/' }]} />

  <section class="hero" style="padding-top:1rem">
    <div class="container">
      <span class="eyebrow">Mudanzas y portes</span>
      <h1>Mudanzas y portes en Madrid</h1>
      <p class="lead">
        Hacemos mudanzas de casas y oficinas, y portes de muebles sueltos, en todo Madrid.
        Nos encargamos de la carga, el transporte y la descarga, y el día y la hora los
        eliges tú.
      </p>
      <div class="btn-row">
        <a class="btn btn--whatsapp" href={whatsappLink(whatsappMsg)} data-track="whatsapp">
          <Icon name="whatsapp" style="width:20px;height:20px" />
          Pedir presupuesto por WhatsApp
        </a>
        <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
          <Icon name="phone" style="width:20px;height:20px" />
          Llamar
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Qué hacemos</span>
        <h2>Mudanzas completas y portes</h2>
      </div>
      <div class="grid grid--2">
        <div class="card">
          <Icon name="truck" class="icon" />
          <h3>Mudanzas de casas</h3>
          <p>
            Traslados completos de pisos y viviendas, con cuidado en la carga y el
            transporte de tus muebles, electrodomésticos y cajas.
          </p>
        </div>
        <div class="card">
          <Icon name="shield" class="icon" />
          <h3>Mudanzas de oficinas y locales</h3>
          <p>
            Traslado de mobiliario y equipos de oficina, coordinado para no interrumpir tu
            actividad más de lo necesario.
          </p>
        </div>
        <div class="card">
          <Icon name="check" class="icon" />
          <h3>Portes de muebles sueltos</h3>
          <p>
            Si solo necesitas mover un sofá, un armario, una lavadora o unas pocas cosas,
            también lo hacemos. No hace falta que sea una mudanza entera.
          </p>
        </div>
        <div class="card">
          <Icon name="clock" class="icon" />
          <h3>Día y hora a tu medida</h3>
          <p>
            Atendemos por teléfono y WhatsApp todos los días, y el traslado lo hacemos
            cuando mejor te venga.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cómo funciona</span>
        <h2>Tu mudanza en tres pasos</h2>
      </div>
      <div class="grid grid--3">
        {steps.map((step, i) => (
          <div class="card card--step">
            <span class="step-num">{i + 1}</span>
            <Icon name={step.icon} class="icon" />
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Lo que no te llevas</span>
        <h2>Nos llevamos lo que ya no quieres</h2>
        <p>
          En casi todas las mudanzas aparecen muebles viejos, trastos o electrodomésticos que
          no merece la pena llevar a la casa nueva. Como también nos dedicamos a los{' '}
          <a href="/vaciado-de-pisos-y-naves/">vaciados de pisos, locales y naves</a>,
          podemos retirarlo en el mismo viaje.
        </p>
        <p>
          Y si entre lo que sobra hay chatarra o metales, como radiadores, tuberías, cable o
          electrodomésticos, te lo compramos igual que en cualquier{' '}
          <a href="/como-funciona/">recogida de chatarra</a>. Puedes ver qué metales
          compramos en <a href="/gestion-de-metales/">gestión de metales</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Zonas</span>
        <h2>Mudanzas en todo Madrid</h2>
        <p>
          Con base en Getafe, hacemos mudanzas y portes en todo Madrid: dentro de Madrid
          capital y en municipios como Getafe, Leganés, Fuenlabrada, Alcorcón, Móstoles,
          Pinto, Parla o Valdemoro. Dinos el origen y el destino y te decimos cómo lo
          organizamos.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Faq items={faqItems} title="Preguntas sobre mudanzas y portes" />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="cta-final">
        <h2>¿Tienes una mudanza en marcha?</h2>
        <p style="margin-inline:auto">Cuéntanos qué hay que mover y desde/hasta dónde. Te damos un presupuesto sin compromiso.</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={whatsappLink(whatsappMsg)} data-track="whatsapp">
            <Icon name="whatsapp" style="width:20px;height:20px" />
            Pedir presupuesto por WhatsApp
          </a>
          <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
            <Icon name="phone" style="width:20px;height:20px" />
            Llamar
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
