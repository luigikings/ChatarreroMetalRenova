---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, whatsappLink } from '../config/site';

const title = 'Cómo funciona la recogida de chatarra | MetalRenova';
const description =
  'Así vendemos tu chatarra en 3 pasos: fotos por WhatsApp, precio al momento y recogida a domicilio con pago inmediato en Getafe y Madrid, todos los días.';

const steps = [
  {
    icon: 'camera' as const,
    title: 'Envíanos fotos por WhatsApp',
    text: 'Nos cuentas qué material tienes, más o menos cuánta cantidad, y nos mandas unas fotos. Con eso nos hacemos una idea del peso y te damos un precio orientativo antes de venir.',
  },
  {
    icon: 'clock' as const,
    title: 'Quedamos el día y la hora',
    text: 'Te confirmamos si podemos ir el mismo día (según disponibilidad y zona) o buscamos el mejor momento para ti. Vamos con nuestro propio vehículo y las herramientas para cargar.',
  },
  {
    icon: 'coin' as const,
    title: 'Recogemos y te pagamos al momento',
    text: 'Cargamos el material, lo pesamos delante de ti si hace falta y te pagamos ahí mismo, en efectivo. Sin papeleos ni esperas.',
  },
];
---

<Layout title={title} description={description} breadcrumbs={[{ name: 'Cómo funciona', path: '/como-funciona/' }]}>
  <Breadcrumbs items={[{ name: 'Cómo funciona', path: '/como-funciona/' }]} />

  <section class="hero" style="padding-top:1rem">
    <div class="container">
      <span class="eyebrow">Proceso</span>
      <h1>Cómo funciona la recogida de chatarra</h1>
      <p class="lead">
        Vendemos tu chatarra sin que te muevas de casa. Así de simple es el proceso, de
        principio a fin.
      </p>
      <div class="btn-row">
        <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, quiero saber cómo funciona la recogida de chatarra.')} data-track="whatsapp">
          <Icon name="whatsapp" style="width:20px;height:20px" />
          Empezar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {steps.map((step, i) => (
          <div class="card card--step">
            <span class="step-num">{i + 1}</span>
            <Icon name={step.icon} class="icon" />
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">También hacemos</span>
        <h2>Vaciados y transporte de carga pesada</h2>
        <p>
          Si además de chatarra necesitas liberar un piso, un local o una nave, o mover
          objetos voluminosos, también nos encargamos. Contamos con la maquinaria necesaria
          para cargar lo que un particular no puede mover solo.
        </p>
      </div>
      <a class="btn btn--call" href="/servicios/">Ver todos los servicios →</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-final">
        <h2>¿Empezamos?</h2>
        <p style="margin-inline:auto">Mándanos fotos de tu material y te decimos el precio en minutos.</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, quiero saber cómo funciona la recogida de chatarra.')} data-track="whatsapp">
            <Icon name="whatsapp" style="width:20px;height:20px" />
            Pide tu valoración por WhatsApp
          </a>
          <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
            <Icon name="phone" style="width:20px;height:20px" />
            Llamar
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
