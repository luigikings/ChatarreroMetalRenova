---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { site, whatsappLink } from '../config/site';
import precios from '../data/precios.json';
import { formatearFechaLegible } from '../lib/fecha';

const title = 'Precios de la chatarra en Madrid | MetalRenova';
const description =
  'Consulta cuánto pagamos por cobre, aluminio, latón, hierro y otros metales en Madrid. Precio bajo consulta, confirmado por WhatsApp con fotos.';

const fechaActualizacion = formatearFechaLegible(precios.actualizado);

// Anclas descriptivas con el H1 exacto de cada página de material (plan §11).
const anclasDescriptivas: Record<string, string> = {
  cobre: 'Compra de cobre en Madrid →',
  aluminio: 'Compra de aluminio en Madrid →',
  laton: 'Compra de latón en Madrid →',
  'hierro-y-acero': 'Compra de hierro y acero en Madrid →',
  baterias: 'Compra de baterías usadas en Madrid →',
};

function priceLabel(desde: number | null, hasta: number | null) {
  if (desde === null || hasta === null) return 'Consúltanos por WhatsApp';
  return `${desde}–${hasta} €/kg`;
}

const faqItems = [
  {
    question: '¿Por qué no ponéis precios fijos en la web?',
    answer:
      'Porque el precio de los metales cambia cada día según la cotización internacional. Un precio publicado hoy podría no ser real mañana, así que preferimos confirmártelo por WhatsApp en el momento.',
  },
  {
    question: '¿El cobre se paga igual pelado que sin pelar?',
    answer:
      'No. El cobre limpio (sin plástico ni aislante) suele valer más que el cable con recubrimiento, porque su pureza es mayor. Te lo confirmamos al ver las fotos.',
  },
  {
    question: '¿Cómo sé el precio antes de que vengáis?',
    answer:
      'Nos mandas fotos del material por WhatsApp y te damos un precio orientativo antes de desplazarnos. El precio final se confirma al pesarlo en el momento de la recogida.',
  },
  {
    question: '¿En qué formato pagáis?',
    answer: 'Te pagamos al momento, en efectivo, nada más pesar el material.',
  },
];
---

<Layout title={title} description={description} breadcrumbs={[{ name: 'Precios de la chatarra', path: '/precios-chatarra/' }]}>
  <section class="hero" style="padding-top:1rem">
    <div class="container">
      <span class="eyebrow">Precios</span>
      <h1>Precios de la chatarra en Madrid</h1>
      <p class="lead">
        Precios bajo consulta: el valor real de cada metal cambia día a día según
        el mercado. Te confirmamos el precio exacto por WhatsApp con fotos de tu material.
      </p>
      <div class="btn-row">
        <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, quiero saber el precio actual de mi material.')} data-track="whatsapp">
          <Icon name="whatsapp" style="width:20px;height:20px" />
          Pide el precio de hoy por WhatsApp
        </a>
      </div>
      {fechaActualizacion && (
        <p style="font-size:0.85rem;color:var(--text-muted);margin-top:1rem">
          Última actualización de esta página: {fechaActualizacion}
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {precios.materiales.map((m) => (
          <div class="material-card">
            <span class="material-card__name">{m.material}</span>
            <span class="material-card__price">{priceLabel(m.precio_desde, m.precio_hasta)}</span>
            {m.pagina && <a href={m.pagina}>{anclasDescriptivas[m.slug] ?? m.material}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Por material</span>
        <h2>Qué influye en el precio de cada material</h2>
      </div>
      <div class="grid grid--3">
        <div class="card">
          <h3>Cobre</h3>
          <p>Cable pelado o sin pelar, tuberías, motores y restos eléctricos. El cobre limpio, sin funda de plástico ni mezclado con otros metales, suele valer más que el cable con recubrimiento, por su pureza.</p>
          <a href="/compra-de-cobre/">Compra de cobre en Madrid →</a>
        </div>
        <div class="card">
          <h3>Aluminio</h3>
          <p>Perfiles y marcos de ventanas, chapa, llantas, estructuras y piezas industriales. Pesa poco pero, en cantidad, tiene buen valor; si viene con otros materiales de la misma reforma u obra, nos lo llevamos todo en la misma visita.</p>
          <a href="/compra-de-aluminio/">Compra de aluminio en Madrid →</a>
        </div>
        <div class="card">
          <h3>Latón</h3>
          <p>Grifería, válvulas, piezas mecánicas y de cerrajería, y restos de producción. Se reconoce por su color dorado y porque no es magnético; si las piezas vienen mezcladas con otros metales, las clasificamos en la recogida.</p>
          <a href="/compra-de-laton/">Compra de latón en Madrid →</a>
        </div>
        <div class="card">
          <h3>Hierro y acero</h3>
          <p>Estructuras, vigas, electrodomésticos, maquinaria y acero inoxidable de hostelería. Por su peso y volumen coordinamos la recogida con antelación para llevar el vehículo y las herramientas adecuadas; también recogemos piezas sueltas como bañeras, radiadores o calderas.</p>
          <a href="/compra-de-hierro-y-acero/">Compra de hierro y acero en Madrid →</a>
        </div>
        <div class="card">
          <h3>Baterías usadas</h3>
          <p>Baterías de coche, moto, maquinaria y equipos estacionarios, también agotadas o dañadas siempre que no tengan roturas graves que provoquen derrames. Dinos cuántas tienes y de qué tipo y te damos el precio antes de venir.</p>
          <a href="/compra-de-baterias/">Compra de baterías usadas en Madrid →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cómo se calcula</span>
        <h2>Qué mueve el precio de tu chatarra</h2>
      </div>
      <div class="grid grid--3">
        <div class="card">
          <h3>Cotización del metal</h3>
          <p>Cada metal tiene un precio de referencia en el mercado internacional que sube y baja a diario.</p>
        </div>
        <div class="card">
          <h3>Pureza del material</h3>
          <p>Un metal limpio y sin mezclar con otros materiales vale más que uno mezclado o con restos de plástico.</p>
        </div>
        <div class="card">
          <h3>Cantidad</h3>
          <p>Cuanta más cantidad tengas, más te interesa que vengamos a recogerla en un solo viaje.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Faq items={faqItems} />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="cta-final">
        <h2>¿Cuánto vale tu chatarra?</h2>
        <p style="margin-inline:auto">Mándanos fotos por WhatsApp y te decimos el precio de hoy.</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, quiero saber el precio actual de mi material.')} data-track="whatsapp">
            <Icon name="whatsapp" style="width:20px;height:20px" />
            Pide el precio de hoy
          </a>
          <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
            <Icon name="phone" style="width:20px;height:20px" />
            Llamar
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
