---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { site, whatsappLink } from '../config/site';
import precios from '../data/precios.json';
import fotoChatarraExterior from '../assets/images/chatarra-hierro-exterior.jpg';
import fotoEquipoCargando from '../assets/images/equipo-cargando-hierro.jpg';
import fotoMaterialClasificado from '../assets/images/material-clasificado-perfiles.jpg';

const title = 'Chatarrero en Getafe y Madrid | MetalRenova';
const description =
  'Compramos chatarra y metales en Getafe y el sur de Madrid, con recogida a domicilio y pago inmediato. Pide tu valoración gratis por WhatsApp.';

const steps = [
  {
    icon: 'camera' as const,
    title: 'Envía fotos por WhatsApp',
    text: 'Nos cuentas qué material tienes y cuánto, con unas fotos nos hacemos una idea del precio.',
  },
  {
    icon: 'coin' as const,
    title: 'Te decimos el precio y agendamos',
    text: 'Te damos un precio orientativo antes de venir y quedamos el día y la hora que mejor te vengan.',
  },
  {
    icon: 'truck' as const,
    title: 'Recogemos y te pagamos al momento',
    text: 'Vamos a tu domicilio, pesamos el material delante de ti y te pagamos ahí mismo.',
  },
];

function priceLabel(desde: number | null, hasta: number | null) {
  if (desde === null || hasta === null) return 'Consúltanos por WhatsApp';
  return `${desde}–${hasta} €/kg`;
}

// En home solo mostramos los 6 materiales principales; el resto vive en /gestion-de-metales/.
const homeMaterialSlugs = ['cobre', 'aluminio', 'laton', 'hierro-y-acero', 'plomo', 'baterias'];
const homeMateriales = precios.materiales.filter((m) => homeMaterialSlugs.includes(m.slug));

const faqItems = [
  {
    question: '¿Cuánto pagáis por el cobre?',
    answer:
      'El precio del cobre cambia cada día según el mercado del metal. Mándanos fotos por WhatsApp y te decimos el precio antes de venir a recogerlo.',
  },
  {
    question: '¿Venís hoy?',
    answer:
      'Intentamos recoger el mismo día según disponibilidad y la zona. Escríbenos por WhatsApp y te confirmamos franja horaria.',
  },
  {
    question: '¿Qué necesito para vender chatarra?',
    answer:
      'Nada especial. Ten el material accesible y, si tienes bastante cantidad, haznos unas fotos para calcular el peso aproximado antes de ir.',
  },
  {
    question: '¿Cobráis por la recogida?',
    answer: 'No. La recogida y el transporte están incluidos cuando te compramos el material.',
  },
  {
    question: '¿En qué zonas trabajáis?',
    answer:
      'En Getafe y alrededores: Leganés, Fuenlabrada, Alcorcón, Móstoles, Pinto, Parla y Madrid capital.',
  },
];

// Reseñas reales de nuestra ficha de Google (transcritas literalmente, sin editar el texto).
const reviews = [
  { name: 'Juan Moreno', initial: 'J', color: 'pink', time: 'Hace 4 meses', text: 'Servicio muy bueno y muy rápido los llamé para vender mi chatarra y la vendí en tan solo 5 minutos' },
  { name: 'Sonia Rubia', initial: 'S', color: 'magenta', time: 'Hace 4 meses', text: 'Contacte con ellos para vender chatarra y me lo pesaron al momento en 15 minutos lo tenia todo vendido los recomiendo' },
  { name: 'Ramon Jimenez', initial: 'R', color: 'copper', time: 'Hace 4 meses', text: 'Los mejores precios del mercado' },
  { name: 'David Jimenez', initial: 'D', color: 'cyan', time: 'Hace 4 días', text: 'Muy profesionales los recomiendo' },
  { name: 'Miguel Vargas moreno', initial: 'M', color: 'orange', time: 'Hace 4 meses', text: 'Muy buen servicio y profesionales' },
  { name: 'Indira Vargas Moreno', initial: 'I', color: 'brown', time: 'Hace 4 meses', text: 'Muy eficaces y rápidos y muy buen trato' },
];
---

<Layout title={title} description={description} isHome>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Chatarrero en Getafe y sur de Madrid</span>
      <h1>Vendemos tu chatarra hoy mismo, sin que te muevas de casa</h1>
      <p class="lead">
        Recogemos cobre, aluminio, hierro y otros metales en Getafe y alrededores.
        Te damos el precio por WhatsApp antes de venir y te pagamos al momento.
      </p>
      <div class="btn-row">
        <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, quiero pedir una valoración de mi chatarra.')} data-track="whatsapp">
          <Icon name="whatsapp" style="width:20px;height:20px" />
          Pide tu valoración por WhatsApp
        </a>
        <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
          <Icon name="phone" style="width:20px;height:20px" />
          Llamar
        </a>
      </div>
      <ul class="trust-chips">
        <li><Icon name="check" />Recogida el mismo día, según disponibilidad</li>
        <li><Icon name="coin" />Pago inmediato en mano</li>
        <li><Icon name="mappin" />Getafe, Leganés, Fuenlabrada y alrededores</li>
        <li><Icon name="clock" />{site.hours.label}</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Cómo funciona</span>
        <h2>De la foto al pago, en tres pasos</h2>
      </div>
      <div class="grid grid--3">
        {steps.map((step, i) => (
          <div class="card card--step">
            <span class="step-num">{i + 1}</span>
            <Icon name={step.icon} class="icon" />
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Materiales</span>
        <h2>Qué metales compramos</h2>
        <p>Precio orientativo por kilo. Te confirmamos el precio final por WhatsApp con fotos del material.</p>
      </div>
      <div class="grid grid--3">
        {homeMateriales.map((m) => (
          <div class="material-card">
            <span class="material-card__name">{m.material}</span>
            <span class="material-card__price">{priceLabel(m.precio_desde, m.precio_hasta)}</span>
            <a href={m.pagina ?? '/gestion-de-metales/'}>Más información →</a>
          </div>
        ))}
      </div>
      <p style="margin-top:1.5rem"><a href="/precios-chatarra/">Ver todos los materiales y precios →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Zonas</span>
        <h2>Dónde recogemos chatarra</h2>
        <p>Con base en Getafe, cubrimos el sur de la Comunidad de Madrid.</p>
      </div>
      <ul class="zone-list">
        {site.zones.map((zone) => (
          <li><a href={zone.page}>{zone.name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Nuestro trabajo</span>
        <h2>Fotos de recogidas reales</h2>
      </div>
      <div class="grid grid--3">
        <Image src={fotoChatarraExterior} alt="Chatarra de hierro y acero recogida por MetalRenova" width={480} height={360} class="gallery-photo" loading="lazy" />
        <Image src={fotoEquipoCargando} alt="Equipo de MetalRenova cargando material en el camión" width={480} height={360} class="gallery-photo" loading="lazy" />
        <Image src={fotoMaterialClasificado} alt="Perfiles de aluminio y acero clasificados para reciclar" width={480} height={360} class="gallery-photo" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Opiniones</span>
        <h2>Lo que dicen nuestros clientes</h2>
        <p>Reseñas reales de nuestra ficha de Google.</p>
      </div>
      <div class="grid grid--3">
        {reviews.map((review) => (
          <div class="review-card">
            <div class="review-card__head">
              <span class={`review-avatar review-avatar--${review.color}`}>{review.initial}</span>
              <strong>{review.name}</strong>
            </div>
            <div class="review-stars" aria-label="5 de 5 estrellas">★★★★★ <span class="review-meta">{review.time}</span></div>
            <p class="mt-0">{review.text}</p>
          </div>
        ))}
      </div>
      <a class="btn btn--call" href={site.googleBusinessUrl} target="_blank" rel="noopener noreferrer" style="margin-top:1.5rem">
        Ver todas las opiniones en Google
      </a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <Faq items={faqItems} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-final">
        <h2>¿Tienes chatarra para vender?</h2>
        <p style="margin-inline:auto">Escríbenos por WhatsApp con unas fotos y te decimos el precio en minutos.</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, quiero pedir una valoración de mi chatarra.')} data-track="whatsapp">
            <Icon name="whatsapp" style="width:20px;height:20px" />
            Pide tu valoración por WhatsApp
          </a>
          <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
            <Icon name="phone" style="width:20px;height:20px" />
            Llamar
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
