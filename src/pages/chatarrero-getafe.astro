---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { site, whatsappLink } from '../config/site';

const title = 'Chatarrero en Getafe | MetalRenova';
const description =
  'Somos un chatarrero con base en Getafe: recogida de chatarra a domicilio y pago inmediato. Cobre, aluminio, hierro y más metales, el mismo día.';

const faqItems = [
  {
    question: '¿Trabajáis en todo Getafe?',
    answer: 'Sí, cubrimos todo el municipio de Getafe. Como es donde tenemos nuestra base, solemos poder ir el mismo día.',
  },
  {
    question: '¿Puedo llevar yo la chatarra en vez de que vengáis vosotros?',
    answer: 'No hace falta. Vamos nosotros a tu domicilio, taller o local en Getafe sin coste, así te ahorras el viaje.',
  },
  {
    question: '¿Qué necesito para que vengáis a Getafe?',
    answer: 'Solo escribirnos por WhatsApp con unas fotos del material y tu dirección. Nosotros nos encargamos del resto.',
  },
];
---

<Layout title={title} description={description} breadcrumbs={[{ name: 'Chatarrero en Getafe', path: '/chatarrero-getafe/' }]}>
  <Breadcrumbs items={[{ name: 'Chatarrero en Getafe', path: '/chatarrero-getafe/' }]} />

  <section class="hero" style="padding-top:1rem">
    <div class="container">
      <span class="eyebrow">Getafe</span>
      <h1>Chatarrero en Getafe</h1>
      <p class="lead">
        MetalRenova tiene su base en Getafe, en Calle Pensamiento. Al estar aquí mismo,
        normalmente somos de los primeros en poder pasar a recoger tu chatarra, muchas
        veces el mismo día.
      </p>
      <div class="btn-row">
        <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, estoy en Getafe y tengo chatarra para vender.')} data-track="whatsapp">
          <Icon name="whatsapp" style="width:20px;height:20px" />
          Pide recogida en Getafe
        </a>
        <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
          <Icon name="phone" style="width:20px;height:20px" />
          Llamar
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Servicio en Getafe</span>
        <h2>Recogida de chatarra a domicilio en Getafe</h2>
        <p>
          Compramos cobre, aluminio, hierro, latón y el resto de metales que puedes ver en
          nuestra página de <a href="/gestion-de-metales/">gestión de metales</a>. Da igual
          si es un particular con material acumulado en casa, un taller o una obra: nos
          desplazamos, valoramos el material y te pagamos al momento.
        </p>
        <p>
          Si además necesitas vaciar un piso, un local o una nave en Getafe, también nos
          encargamos de eso: revisa nuestro <a href="/servicios/">catálogo de servicios</a>
          para ver todo lo que hacemos.
        </p>
        <p>
          No trabajamos solo con particulares: también recogemos metal de talleres,
          tiendas y pequeños negocios de Getafe que generan chatarra de forma habitual,
          como restos de instalaciones, piezas obsoletas o material sobrante de una obra.
        </p>
        <p>
          Y si lo que necesitas es liberar espacio en vez de vender metal suelto, también
          hacemos <a href="/vaciado-de-pisos-y-naves/">vaciados de pisos, locales y
          naves</a> en Getafe, coordinando todo desde la primera llamada.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <Faq items={faqItems} title="Preguntas sobre el servicio en Getafe" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-final">
        <h2>¿Tienes chatarra en Getafe?</h2>
        <p style="margin-inline:auto">Escríbenos por WhatsApp con fotos y te decimos el precio en minutos.</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, estoy en Getafe y tengo chatarra para vender.')} data-track="whatsapp">
            <Icon name="whatsapp" style="width:20px;height:20px" />
            Pide recogida en Getafe
          </a>
          <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
            <Icon name="phone" style="width:20px;height:20px" />
            Llamar
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
