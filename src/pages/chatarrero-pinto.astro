---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { site, whatsappLink } from '../config/site';

const title = 'Chatarrero en Pinto | MetalRenova';
const description =
  'Compramos chatarra y metales en Pinto con recogida a domicilio y pago al momento. Cobre, aluminio, hierro y más, sin coste por la recogida.';

const faqItems = [
  {
    question: '¿Cobráis algo por ir a Pinto a recoger el material?',
    answer: 'No, la recogida está incluida en el servicio, vengamos a Pinto o a cualquier otra zona donde trabajamos.',
  },
  {
    question: '¿Y si tengo poca cantidad de chatarra?',
    answer: 'No pasa nada, no exigimos una cantidad mínima. Mándanos fotos y te decimos si merece la pena que vayamos.',
  },
];
---

<Layout title={title} description={description} breadcrumbs={[{ name: 'Chatarrero en Pinto', path: '/chatarrero-pinto/' }]}>
  <Breadcrumbs items={[{ name: 'Chatarrero en Pinto', path: '/chatarrero-pinto/' }]} />

  <section class="hero" style="padding-top:1rem">
    <div class="container">
      <span class="eyebrow">Pinto</span>
      <h1>Chatarrero en Pinto</h1>
      <p class="lead">
        Recogemos chatarra y metales en Pinto sin que tengas que moverte de casa. Nos
        escribes por WhatsApp con unas fotos y te decimos el precio antes de venir.
      </p>
      <div class="btn-row">
        <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, estoy en Pinto y tengo chatarra para vender.')} data-track="whatsapp">
          <Icon name="whatsapp" style="width:20px;height:20px" />
          Pide recogida en Pinto
        </a>
        <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
          <Icon name="phone" style="width:20px;height:20px" />
          Llamar
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Servicio en Pinto</span>
        <h2>Recogida de metales a domicilio en Pinto</h2>
        <p>
          Compramos cobre, aluminio, hierro, latón, baterías y el resto de materiales que
          puedes ver en <a href="/gestion-de-metales/">gestión de metales</a>, siguiendo
          siempre el mismo proceso que explicamos en
          <a href="/como-funciona/">cómo funciona</a>: fotos, precio orientativo y recogida
          con pago al momento.
        </p>
        <p>
          Si además necesitas vaciar un piso o un trastero en Pinto, también podemos
          ayudarte: mira nuestro <a href="/servicios/">catálogo de servicios</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <Faq items={faqItems} title="Preguntas sobre el servicio en Pinto" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-final">
        <h2>¿Tienes chatarra en Pinto?</h2>
        <p style="margin-inline:auto">Escríbenos por WhatsApp con fotos y te decimos el precio en minutos.</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={whatsappLink('Hola MetalRenova, estoy en Pinto y tengo chatarra para vender.')} data-track="whatsapp">
            <Icon name="whatsapp" style="width:20px;height:20px" />
            Pide recogida en Pinto
          </a>
          <a class="btn btn--call" href={`tel:${site.phonePrimaryTel}`} data-track="llamar">
            <Icon name="phone" style="width:20px;height:20px" />
            Llamar
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
