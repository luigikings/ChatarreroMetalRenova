---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../config/site';
import { negocioSchema, servicioSchema, migasSchema, aJsonLd } from '../lib/schema';
import '../styles/global.css';

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Breadcrumb[];
  /** Si la página describe un servicio concreto, se emite su marcado Service. */
  servicio?: { nombre: string };
  /** Sin uso desde que el marcado del negocio sale en todas las páginas indexables. */
  isHome?: boolean;
  noindex?: boolean;
}

const { title, description, breadcrumbs = [], servicio, noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url).toString();

// Fuente única de las migas: se pintan abajo y se marcan con los mismos datos.
const breadcrumbSchema = migasSchema(breadcrumbs, site.url);
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {!noindex && <link rel="canonical" href={canonicalURL} />}
  {noindex && <meta name="robots" content="noindex, follow" />}

  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="preload" href="/fonts/barlow-condensed-latin-700.woff2" as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:image" content={`${site.url}/og-image.jpg`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="MetalRenova — Chatarrería en Madrid" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={`${site.url}/og-image.jpg`} />

  {!noindex && (
    <script type="application/ld+json" set:html={aJsonLd(negocioSchema(site))} />
  )}
  {servicio && !noindex && (
    <script type="application/ld+json" set:html={aJsonLd(servicioSchema(servicio.nombre, canonicalURL, site.url))} />
  )}
  {breadcrumbSchema && (
    <script type="application/ld+json" set:html={aJsonLd(breadcrumbSchema)} />
  )}
</head>
<body>
  <a href="#main" class="skip-link">Saltar al contenido</a>
  <Header />
  <main id="main">
    {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
    <slot />
  </main>
  <Footer />
  <MobileCta />
  <CookieConsent />
</body>
</html>
